# HTTPS example; replace domain/certificate paths. This is not installed automatically.
# Configure ACM_ALLOWED_HOSTS=acm.example.com and
# ACM_PUBLIC_ORIGIN=https://acm.example.com in the application.
# Trust only the real proxy address in ACM_TRUSTED_PROXIES / FORWARDED_ALLOW_IPS.
#
# When the application runs in Docker and Nginx runs on the host, the container
# sees the Docker bridge gateway (for example 172.17.0.1), not 127.0.0.1. Put that
# address in ACM_TRUSTED_PROXIES, or run Nginx in the same compose network and
# use the service name, otherwise every client shares one rate-limit bucket.
#
# Add "listen [::]:80" / "listen [::]:443 ssl" below only when the host has IPv6.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    return 444;
}

server {
    listen 80;
    server_name acm.example.com;
    server_tokens off;
    return 308 https://acm.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name acm.example.com;
    ssl_certificate /etc/letsencrypt/live/acm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/acm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    # A default TLS vhost can otherwise receive unknown Host values too.
    if ($host != acm.example.com) { return 444; }
    client_max_body_size 512k;
    client_header_timeout 10s;
    large_client_header_buffers 4 8k;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # Send the client's normalized host (lowercased, no port, no trailing
        # dot), never a fixed allowed value: the application still enforces
        # ACM_ALLOWED_HOSTS. Some clients send uppercase or trailing-dot hosts;
        # $host keeps those from being rejected by the exact-match allowlist.
        # A Host header that is missing entirely falls back to this server_name,
        # so HTTP/1.0 requests reach the app with the configured name.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # For a single edge proxy, discard untrusted client-supplied XFF.
        # A CDN chain needs set_real_ip_from for that CDN's verified addresses.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header Server;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        # Do not retry a potentially non-idempotent platform submission.
        proxy_next_upstream off;
        # Normal security response headers come only from ACM Lab.
        # Preserve application errors and Retry-After; format only errors
        # generated by Nginx itself (for example an unavailable upstream).
        proxy_intercept_errors off;
        error_page 502 503 504 = @gateway_error;
    }

    location @gateway_error {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        return 503 '{"detail":"服务暂时不可用，请稍后重试"}';
    }
}
