# scripts/bootstrap.py 会生成随机访问令牌，实际 .env 不提交 Git。
ACM_ACCESS_TOKEN=replace-with-at-least-24-random-characters
ACM_ENV=production
ACM_MULTI_USER=true
# 加入实际网站域名，多个域名用逗号分隔，不填写协议或端口。
ACM_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 成员仅能连接管理员批准的 AI 提供方；可加入其他提供方的实际 API 域名。
ACM_AI_ALLOWED_HOSTS=api.openai.com,api.deepseek.com,api.anthropic.com,generativelanguage.googleapis.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,api.moonshot.cn,api.siliconflow.cn,open.bigmodel.cn
# 配置公网域名时同时填写：https://acm.example.com（须也在上面的域名列表）。
ACM_PUBLIC_ORIGIN=
# 只填写实际反向代理的 IP，影响真实客户端 IP 与限流，不要设置为 *。
ACM_TRUSTED_PROXIES=127.0.0.1
ACM_ENABLE_CODEX=false
# 无桌面服务器官方设备码登录。多人模式每用户独立授权，两项同时启用。
ACM_ENABLE_SERVER_CODEX=false
ACM_IMAGE_TARGET=runtime
# 使用官方账号镜像时：ACM_ENABLE_SERVER_CODEX=true，ACM_IMAGE_TARGET=server-codex
ACM_DATA_DIR=data
ACM_DATA_SUBDIR=
ACM_ACCOUNTS_CONFIG=account.toml
ACM_STATIC_DIR=frontend/dist
ACM_UID=1000
ACM_GID=1000
# OPENAI_API_KEY 仅旧版个人模式使用；多人模式请各自在网页保存自己的 Key。
# OPENAI_API_KEY=
# 可选：服务器代调用官方翻译服务。密钥只在服务端使用，可能产生费用；未配置时网页提供官方翻译入口。
# ACM_GOOGLE_TRANSLATE_KEY=
# ACM_BING_TRANSLATE_KEY=
# ACM_BING_TRANSLATE_REGION=
